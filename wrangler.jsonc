{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acresx",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "RESO_BASE_URL": "https://api-demo.mlsgrid.com/v2",
    "RESO_PROVIDER": "mlsgrid",
    "RESO_ORIGINATING_SYSTEM_NAME": "sarmls"
  },
  "d1_databases": [
    {
      "binding": "MLS_DB",
      "database_name": "acresx-mls",
      "database_id": "976c0bbe-4831-498b-a464-dabf2901363f"
    }
  ],
  "observability": { "enabled": true }
}
